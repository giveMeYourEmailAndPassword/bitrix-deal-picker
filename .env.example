# ===== Обязательные переменные (задаются в Railway → Variables) =====

# Вебхук Bitrix24 (секрет). На VibeCode лежал в .env.bitrix.
BITRIX_WEBHOOK_BASE=https://krugosvet.bitrix24.kz/rest/41/XXXXXXXXXXXXXXXX/

# Режим работы: 0 — реальные вызовы в Bitrix24, 1 — dry-run (без записи)
DRY_RUN=0

# Сетевой бинд. Railway требует слушать 0.0.0.0.
HOST=0.0.0.0
PORT=3000

# Публичный HTTPS-адрес приложения (домен Railway или кастомный домен).
PUBLIC_APP_URL=https://your-service.up.railway.app

# ID администраторов через запятую (доступ к админ-панели).
ADMIN_USER_IDS=41

# Разрешать ли не верифицированным пользователям работать с приложением.
ALLOW_UNVERIFIED_USERS=0

# Часовой пояс приложения (смещение от UTC).
APP_TZ_OFFSET_HOURS=6

# Автоматическая отправка приветственного сообщения после принятия заявки.
GREETING_AUTO_SEND=1

# Таймауты запросов к Bitrix24 (секунды).
BITRIX_TIMEOUT_SECONDS=12
BITRIX_FAST_TIMEOUT_SECONDS=5

# Окно без лимитов (по местному времени).
LIMIT_FREE_WINDOW_START=18:00
LIMIT_FREE_WINDOW_END=21:30

# Параметры пакетного поиска сделок.
NEXT_DEAL_SCAN_LIMIT=8
NEXT_DEAL_SCAN_WORKERS=8
NEXT_DEAL_BATCH_TIMEOUT_SECONDS=12
DEAL_ANALYSIS_CACHE_TTL_SECONDS=300

# ===== Файловое состояние (Railway Volume) =====
# Должно совпадать с точкой монтирования Volume в Railway.
# Здесь живут managers.json, access_rules.json, claim_log.json,
# reject_log.json, greeting_log.json.
APP_DATA_DIR=/data
