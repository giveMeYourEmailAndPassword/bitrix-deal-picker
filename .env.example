# Copy values into Railway -> Service -> Variables. Never commit the real
# webhook URL, OAuth token, employee list, or production database.

# --- Required production configuration ---

# Secret incoming-webhook URL. Create a new credential for the hardened release;
# revoke the old one only after the read-only cutover and rollback decision.
BITRIX_WEBHOOK_BASE=https://your-portal.bitrix24.example/rest/REPLACE/REPLACE/

# Exact Bitrix24 portal hostname allowed in OAuth payloads. It must be the same
# hostname as in BITRIX_WEBHOOK_BASE. No scheme, path, wildcard, or slash.
BITRIX_ALLOWED_DOMAINS=your-portal.bitrix24.example

# Canonical public HTTPS URL of this service, without a trailing slash.
PUBLIC_APP_URL=https://deal-picker.example.com

# Exact browser origins allowed to call the API, comma-separated. The
# PUBLIC_APP_URL origin is also allowed automatically. Do not use "*".
APP_ALLOWED_ORIGINS=https://your-portal.bitrix24.example

# Bitrix user IDs permitted to open the admin panel, comma-separated.
ADMIN_USER_IDS=REPLACE_WITH_BITRIX_ADMIN_USER_ID

# --- Safety switches: keep these values for the first deployment ---

# 1 = preview/read-only. Change to 0 only after readiness and Bitrix smoke tests.
DRY_RUN=1

# Poll Bitrix stage history and finish the one exactly linked active OpenLine
# only for a newly proven P/S -> F deal transition. The first worker poll saves
# a remote Bitrix history boundary and performs no close, so old failed deals
# are never backfilled. Keep DRY_RUN=1 for the first controlled verification.
LOST_DEAL_AUTOCLOSE_ENABLED=1
LOST_DEAL_AUTOCLOSE_POLL_SECONDS=15
LOST_DEAL_AUTOCLOSE_GRACE_SECONDS=15
LOST_DEAL_CLOSE_LEASE_SECONDS=120
LOST_DEAL_MAX_PREFLIGHT_ATTEMPTS=5
LOST_DEAL_HISTORY_MOVE_TOLERANCE_SECONDS=5
MAX_LOST_DEAL_STAGE_HISTORY_ROWS=5000

# String custom field on CRM deals. Before DRY_RUN=0, IT creates this field and
# replaces the placeholder with its exact code (for example UF_CRM_..._CLAIM_ID).
BITRIX_CLAIM_MARKER_FIELD=UF_CRM_REPLACE_WITH_CLAIM_MARKER_FIELD

# Keep 0 for the first deployment. After a controlled permission test, 1 sends
# greetings in the background through the claiming manager's verified OAuth
# session. The claim response never waits for delivery.
GREETING_AUTO_SEND=0

# How often the durable greeting outbox checks for newly claimed deals.
GREETING_WORKER_POLL_SECONDS=1

# Never enable in Railway. It works only with DRY_RUN=1 on localhost.
ALLOW_UNVERIFIED_USERS=0

# Export immutable claim events to Baza without enabling the separate +1
# request workflow. Keep 0 until the matching Baza backend is deployed.
CLAIM_EVENT_EXPORT_ENABLED=0

# Extra one-use applications are a separate feature and stay disabled until
# their matching Baza backend/UI release is deployed.
EXTRA_CLAIM_REQUESTS_ENABLED=0

# Enabling either Baza feature without all three values below fails readiness.
BAZA_API_BASE_URL=
BAZA_HMAC_KEY_ID=deal-picker-v1
# Generate an independent random secret of at least 32 bytes. The same value is
# installed only in the Baza backend and this service; never expose it to JS.
BAZA_HMAC_SECRET=REPLACE_ME
# Optional reverse bridge, Baza backend -> this picker. Use a DIFFERENT random
# secret of at least 32 bytes; empty disables all /integrations/baza/v1 routes.
# Fixed key ID: baza-picker-v1. Never expose this value in frontend variables.
BAZA_PICKER_BRIDGE_SECRET=

# Statistics source. app_events uses immutable claim events recorded by this
# application. Unsupported values must fail readiness rather than silently
# falling back to unreliable DATE_MODIFY counts.
CLAIM_STATS_SOURCE=app_events

# This existing service must not accept native writes until the old JSON logs
# have been imported. Fresh installations with no legacy history may use 0.
REQUIRE_LEGACY_MIGRATION=1

# Missing manager rules deny access; an administrator must explicitly enable
# each employee before real claims are possible.
REQUIRE_EXPLICIT_ACCESS_RULE=1

# --- Runtime and persistent state ---

HOST=0.0.0.0
PORT=3000
APP_TZ_OFFSET_HOURS=6
APP_DATA_DIR=/data

# Railway Volumes are root-owned. This lets the entrypoint repair /data before
# it immediately drops to UID/GID 10001. Required on Railway; inert locally.
RAILWAY_RUN_UID=0

# Railway injects RAILWAY_PROJECT_ID, RAILWAY_VOLUME_NAME and
# RAILWAY_VOLUME_MOUNT_PATH automatically. Do not create them manually.
# Readiness requires the detected Railway Volume mount to equal APP_DATA_DIR.

# Filename only (no slash). The file lives inside APP_DATA_DIR.
STATE_DB_FILENAME=state.sqlite3

# --- Request hardening and resource bounds ---

# Per-client sliding-window limit for API requests.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_REQUESTS=64
MAX_CONCURRENT_SEARCHES=4
SOCKET_TIMEOUT_SECONDS=15
READINESS_CACHE_TTL_SECONDS=5

# Reject larger request bodies before reading or decoding JSON (256 KiB).
MAX_REQUEST_BODY_BYTES=262144

# Reject oversized Bitrix JSON before decoding it (5 MiB). OpenLine history is
# additionally limited to 500 message records per selected session.
MAX_BITRIX_RESPONSE_BYTES=5242880

# Server-signed deal-selection proof lifetime (30 minutes). The proof binds the
# manager, deal version and current skills/access policy; a change invalidates it.
SELECTION_TOKEN_TTL_SECONDS=1800
SEARCH_CURSOR_TTL_SECONDS=120

# A crashed claim may be recovered after this lease expires (5 minutes).
CLAIM_OPERATION_PENDING_TTL_SECONDS=300
CLAIM_RECONCILE_INTERVAL_SECONDS=60
CLAIM_RECONCILE_BATCH_SIZE=100

# Signed Baza calls and durable outbox retry bounds. Only enabled outbox kinds
# are delivered. Extra-claim requests are prioritized when that feature is on.
BAZA_TIMEOUT_SECONDS=5
BAZA_MAX_RESPONSE_BYTES=1048576
# Optional Baza manager OAuth callback bridge. Empty keeps it disabled.
# Only this exact HTTPS URL is accepted; do not add a slash, query or credentials:
# https://contracts-backend-production-f1a9.up.railway.app/integrations/bitrix-oauth/callback
BAZA_OAUTH_CALLBACK_URL=
INTEGRATION_OUTBOX_INTERVAL_SECONDS=15
INTEGRATION_OUTBOX_BATCH_SIZE=20

# Bound all in-memory caches and each Bitrix stage scan.
CACHE_MAX_ENTRIES=500
MAX_DEALS_PER_STAGE=1000

# Cache TTLs, seconds.
USER_VERIFY_CACHE_TTL_SECONDS=300
PORTAL_USERS_CACHE_TTL_SECONDS=300
DEAL_ANALYSIS_CACHE_TTL_SECONDS=300
DEAL_HEADERS_CACHE_TTL_SECONDS=10

# --- Bitrix request and deal-search bounds ---

BITRIX_TIMEOUT_SECONDS=12
BITRIX_FAST_TIMEOUT_SECONDS=5
NEXT_DEAL_SCAN_LIMIT=12
NEXT_DEAL_SCAN_WORKERS=12
NEXT_DEAL_BATCH_TIMEOUT_SECONDS=12

# Local business-hours rule in HH:MM, interpreted with APP_TZ_OFFSET_HOURS.
# A configured dailyLimit is bypassed in this half-open window and all Sunday.
LIMIT_FREE_WINDOW_START=18:00
LIMIT_FREE_WINDOW_END=21:30
